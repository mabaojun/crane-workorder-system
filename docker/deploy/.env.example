# ===== 复制为 .env 后按云服务器实际情况修改 =====
# 宿主目录（数据卷、前端构建产物、证书、备份根目录）
DEPLOY_DIR=/crane

# 对外端口（服务器 80/443 需空闲；小程序要求 HTTPS 443）
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
MYSQL_HOST_PORT=7772

# 数据库凭据（必须修改）
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_USERNAME=crane
MYSQL_PASSWORD=change-db-password

# 安全密钥（必须修改：至少 32 位随机串，泄露等于全系统失守）
# 生成：openssl rand -hex 32
CRANE_JWT_SECRET=please-generate-a-random-64-char-secret-string-for-production

# 初始管理员（仅首次启动建号用，之后可改）
CRANE_ADMIN_PHONE=13800000000
CRANE_ADMIN_PASSWORD=Admin@123

# 微信小程序登录（jscode2session）：AppID + AppSecret
# AppSecret 在小程序后台「开发管理-开发设置」获取，必须填写，否则小程序微信登录不可用
WECHAT_APPID=wxcd19e4508b62d824
WECHAT_SECRET=

# 短信通道：真实短信尚未接入，生产必须保持 false（否则验证码会回显到接口响应）
# 关闭后短信登录与微信首次绑定手机号不可用，请先用管理员预设账号 + 密码登录
CRANE_SMS_MOCK=false

# 生产允许的跨域来源（前后端同域部署，通常保持默认域名即可）
CRANE_CORS_ORIGINS=https://jndys.top

# 备份保留天数
BACKUP_KEEP_DAYS=7

# 后端镜像版本（发布包会自动预填；手工填写须与 version.json 一致）
APP_VERSION=
